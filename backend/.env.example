# ── 基础 ───────────────────────────────────────────────────────────────
APP_ENV=dev
APP_NAME=Ask Knowledge AI Learning Partner
APP_SECRET_KEY=dev-only-secret-change-me-at-least-32-bytes
API_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── 日志 ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 日志落盘（相对路径按 backend/ 解析，自动建目录，5MB × 3 轮转）
# 排障必需：Dify 报 400/403 的原因只写在日志里，控制台一滚就没了
LOG_FILE=logs/backend.log

# 数据库：本机开发默认 SQLite（零依赖即可跑通）；生产改 PostgreSQL
# DATABASE_URL=postgresql+psycopg://ak:ak@127.0.0.1:5432/ask_knowledge

# ── 存储 ───────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
# 留空 = 使用 <仓库>/data（内置绝对路径，与 SQLite 库同目录，推荐）
# 若要自定义，请务必写绝对路径：相对路径会随启动时的工作目录漂移
# STORAGE_LOCAL_ROOT=D:/data/ask-knowledge
MAX_UPLOAD_SIZE_MB=15
MAX_UPLOAD_BATCH=10
ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,md,txt,png,jpg,jpeg

# ── 业务默认参数（可被知识库覆盖） ───────────────────────────────────────
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.5
QUIZ_CACHE_MINUTES=30

# ── Dify ───────────────────────────────────────────────────────────────
# http = 调真实 Dify（混合架构主路径，需先起 Dify 1.17.0 并导入 dify/dsl/*.yml）
# mock = 本地离线实现（接口契约与 http 完全一致，用于无 Dify 环境的演示/单测）
DIFY_MODE=mock
DIFY_BASE_URL=http://127.0.0.1/v1
# App A：chat-qa（Chatflow 问答）
DIFY_APP_API_KEY=app-xxx
# 问答编排：app = 后端把 kb_ids 交给 Dify 应用内检索节点（应用需绑定该变量）；
# rag = 后端先按知识库自己的 dataset 检索（POST /datasets/{id}/retrieve）再把资料注入提问，
#       引用来源用后端检索结果 —— advanced-chat 类应用会忽略 inputs.kb_ids，必须用 rag
DIFY_CHAT_MODE=app
# App B：workflow-quiz（出题）
DIFY_QUIZ_WORKFLOW_API_KEY=app-quiz-xxx
# App C：workflow-quiz-grade（简答判分）
DIFY_GRADE_WORKFLOW_API_KEY=app-grade-xxx
# 知识库 API（datasets）：建库/入库/检索
DIFY_DATASET_API_KEY=dataset-xxx
DIFY_TIMEOUT_SECONDS=60
DIFY_WORKFLOW_TIMEOUT_SECONDS=120
DIFY_INDEXING_TIMEOUT_SECONDS=600
DIFY_APP_ID=

# ── Dify 知识库接口配额（见 app/services/dify/quota.py）─────────────────
# Dify 对 /datasets/* 有「订阅侧每分钟请求上限」，超限返回 403 forbidden
# （message 含 "knowledge base request rate limit"），前端会显示「Dify 返回 403」。
# 这里的闸门让本服务不超发；缓存让重复查询（轮询/重复出题）不再消耗配额。
# 0 = 关闭闸门（不建议）
DIFY_KNOWLEDGE_RATE_LIMIT_PER_MINUTE=8
DIFY_KNOWLEDGE_WAIT_SECONDS=15
DIFY_RETRIEVAL_CACHE_SECONDS=60
DIFY_SEGMENTS_CACHE_SECONDS=30
DIFY_DOCUMENTS_CACHE_SECONDS=5
# 入库状态轮询间隔（indexing-status 同样吃上面配额；1 秒一次会在几十秒内打爆）
INDEXING_POLL_INTERVAL_SECONDS=5

# ── 单知识库模式（用户不能建库，上传的文档统一进既有知识库）─────────────
# SINGLE_KB_MODE=true 时：POST /kbs 返回 40301，上传的文档全部写入下面的既有数据集
SINGLE_KB_MODE=false
DEFAULT_KB_NAME=默认知识库
DEFAULT_KB_DATASET_ID=

# ── 文档解析 ───────────────────────────────────────────────────────────
# builtin = 本地纯文本/Markdown 解析（零依赖）；mineru_local = 本地 MinerU 服务；mineru_api = MinerU 官方 API
PARSER_MODE=builtin
# 交给 Dify 侧解析的扩展名（逗号分隔）：这些类型不在本地解析，上传后直传原文件
# → 走 Dify 自带提取器 / 知识库流水线（如「PDF → parse file」分支）
# 留空 = 全部走本地解析（builtin / MinerU）
DIFY_PARSE_EXTENSIONS=pdf
MINERU_BASE_URL=http://127.0.0.1:8888
MINERU_API_TOKEN=
MINERU_TIMEOUT_SECONDS=1800

# ── 内容审核 ───────────────────────────────────────────────────────────
AUDIT_ENABLED=true
# local = 本地敏感词规则引擎（零依赖）；aliyun = 阿里云内容安全
AUDIT_PROVIDER=local
AUDIT_CACHE_MINUTES=1440
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
MODERATION_CALLBACK_TOKEN=change-me-moderation-token

# ── Worker ─────────────────────────────────────────────────────────────
# true = 后端进程内启动后台 worker（单机 MVP）；生产建议单独进程 run_worker.py
WORKER_INLINE=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
